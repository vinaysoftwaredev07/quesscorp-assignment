APP_NAME=HRMS Lite
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hrms_lite
SUPERADMIN_KEY=change-me-superadmin-key
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=hrms.events
RABBITMQ_LISTENER_QUEUE=hrms.activity.listener
RABBITMQ_INTERNAL_TOPIC=internal.#
RABBITMQ_ACTIVITY_TOPIC=activity.#
RABBITMQ_RECONNECT_SECONDS=3
EVENT_PUBLISH_ENABLED=true
EVENT_LISTENER_ENABLED=true
EVENT_SOURCE=hrms.backend
